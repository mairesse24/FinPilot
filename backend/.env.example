# Copy this file to .env and fill in real values. Never commit .env.

# Supabase "Session pooler" connection string (see docs/supabase-setup.md). Leave empty to run on built-in demo data.
DATABASE_URL=

# Comma-separated list of frontend addresses allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Id of the demo customer (printed by the seed script)
DEMO_USER_ID=

# auto = use Member 3's real modules when present; baseline = always use built-in logic
INTELLIGENCE_MODE=auto

# Optional: pin "today" for repeatable demos, e.g. 2026-11-07
AS_OF_DATE=

# Gemini Developer API (server-side only). Missing key uses the baseline Copilot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Entire Copilot generation budget, below the frontend's 30-second request timeout.
COPILOT_TIMEOUT_SECONDS=20
COPILOT_MAX_ROUNDS=4
COPILOT_MAX_TOOL_CALLS=8

# Future Economic Lab integration; not used by the Copilot.
FRED_API_KEY=
