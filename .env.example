# Copy to .env. The forecast itself needs no environment variables.
# gemini = live chatbot; offline = local fixed explanation; openai = optional alternative.
COPILOT_PROVIDER=gemini
GEMINI_API_KEY=
# Choose a function-calling text model available in your Google AI Studio account.
GEMINI_MODEL=gemini-3.8-flash

# Leave these blank when using Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=
