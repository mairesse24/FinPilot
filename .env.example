# Copy to .env. The forecast itself needs no environment variables.
# gemini = live chatbot; offline = local fixed explanation; openai = optional alternative.
COPILOT_PROVIDER=gemini
# Official FRED/ALFRED access; backend only. Refresh via scripts.refresh_intelligence.
FRED_API_KEY=
GEMINI_API_KEY=
# Choose a function-calling text model available in your Google AI Studio account.
GEMINI_MODEL=gemini-3.8-flash

# Leave these blank when using Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=
# Banking source for the integrated FastAPI app (credentials stay on the backend).
DATA_SOURCE=demo
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_SCHEDULES_FILE=
